# Build artifacts and outputs
results/*
!results/.gitkeep
logs/
*.log
*.csv
*.rds
*.parquet
*.png
*.pdf
*.tex
*.zip

# Ox compilation / execution artifacts
*.o
*.out
*.gwg

# empirical/ output directories (generated by prediction scripts)
empirical/*_prediction/
empirical/*_prediction_2020/
empirical/simulation/
empirical/out*/

# data/ contents (licensed, not redistributable)
data/*
!data/.gitkeep

# GitHub Pages source files are tracked (override above)
!docs/**/*.md
!docs/**/*.yml
!docs/**/*.html
!docs/**/*.css
!docs/**/*.js

# Data (keep out proprietary / licensed data)
data/
*.feather

# Local configs / secrets
config/config.ini
.env
*.key
*.pem
id_rsa
.Rprofile
.Renviron
.Rhistory

# OS / editor junk
.DS_Store
Thumbs.db
*.swp
*.swo
